    "usno": {
      "name": "U.S. Naval Observatory, Astronomical Applications Dept \u2014 Sun and Moon Data for One Day (API 4.0.1)",
      "url_template": "https://aa.usno.navy.mil/api/rstt/oneday?date={date}&coords={lat},{lon}&tz=0",
      "resolution": "1 minute, rounded to nearest",
      "convention": "Rise/set is the upper limb at the apparent horizon: geometric centre at -50 arcmin (34 arcmin refraction + 16 arcmin semidiameter). Sea level; the API takes no elevation, so every fixture site uses 0 m.",
