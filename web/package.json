{
  "name": "ssc-web",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "api:codegen": "uv run --project .. python scripts/generate-openapi.py && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "qa:skymap-compliance": "node scripts/skymap-compliance-qa.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.46.0",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
